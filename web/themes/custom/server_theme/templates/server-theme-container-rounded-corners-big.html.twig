{% import '@server_theme/templates/server-theme-bg-color-base.html.twig' as bgColorBase %}

{% set color_class = bgColorBase.getBgColor(bg_color) %}

{% if color_class|trim != 'light-green' %}
  {% set py_class = 'py-2' %}
  {% set px_class = 'px-1' %}
{% endif %}


<div class="rounded-lg overflow-hidden w-fit {{ color_class }} {{ py_class }} {{ px_class }}">
  {{ items }}
</div>
